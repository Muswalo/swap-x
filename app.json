{
  "expo": {
    "name": "SwapX",
    "slug": "swap-x",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "swapx",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "SwapX - Government Employee Job Swap Platform. Find and arrange job location and ministry swaps with ease.",
    "primaryColor": "#007AFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muswalo.swapx",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "SwapX needs access to your camera to take photos for your profile and swap listings.",
        "NSPhotoLibraryUsageDescription": "SwapX needs access to your photo library to upload photos for your profile and swap listings.",
        "NSPhotoLibraryAddUsageDescription": "SwapX needs permission to save photos to your library.",
        "NSLocationWhenInUseUsageDescription": "SwapX uses your location to show nearby swap opportunities."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.muswalo.swapx",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0b20da9-9815-49ef-9c43-c79ff65a248c"
      }
    },
    "owner": "muswalo"
  }
}
